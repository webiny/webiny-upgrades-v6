{
  "name": "webiny-upgrades-v6",
  "version": "1.0.0",
  "type": "module",
  "bin": "./index.js",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "tsc --noEmit",
    "format:fix": "oxfmt 'src/**/*.{ts,js}' '.adiorc.js' 'eslint.config.js' 'index.js' 'tsconfig.json'",
    "format:check": "oxfmt --check",
    "eslint": "eslint \"**/*.{js,ts}\" --max-warnings=0",
    "eslint:fix": "yarn eslint --fix",
    "lint:fix": "yarn eslint --fix && yarn format:fix",
    "adio:check": "adio"
  },
  "dependencies": {
    "@webiny/di": "^0.2.3",
    "execa": "^9.6.1",
    "load-json-file": "^7.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "semver": "^7.7.4",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "type-fest": "^5.6.0",
    "typescript": "6.0.3",
    "write-json-file": "^7.0.0",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/semver": "^7.7.1",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/coverage-v8": "^4.1.4",
    "adio": "^2.1.0",
    "eslint": "^10.2.1",
    "eslint-plugin-import-x": "^4.16.2",
    "oxfmt": "^0.45.0",
    "prettier": "3.8.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@4.14.1"
}
